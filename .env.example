# ═══════════════════════════════════════════════════════════
#  Uni3D · variáveis de ambiente (Coolify)
#  Cole estas no recurso do Coolify › Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Banco (Postgres que você já criou no Coolify) ───────────
# IMPORTANTE: use postgresql+asyncpg:// (o backend é async)
# Host = nome interno do serviço Postgres no mesmo projeto Coolify
DATABASE_URL=postgresql+asyncpg://USUARIO:SENHA@HOST_INTERNO:5432/uni3d

# ── MinIO (storage de arquivos, sobe junto no compose) ──────
MINIO_USER=uni3d
MINIO_PASSWORD=-XL7p1ewWhAe-H3xxZQzptPh2unkiRGt

# ── JWT ─────────────────────────────────────────────────────
SECRET_KEY=d76fb57f575e9e87bc9630807757f1f91e7e243268ee9b6c0fcbd4952f1a90e9

# ── Domínio ─────────────────────────────────────────────────
ALLOWED_ORIGINS=https://uni3d.unicontroller.com.br
